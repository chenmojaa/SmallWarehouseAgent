# ===== LLM (切换模型只改这里) =====
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-replace-me
LLM_API_BASE=

# ===== Embedding =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DEVICE=cpu

# ===== Server =====
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# ===== Storage (P2 启用) =====
# DATA_DIR=./data
# CHROMA_DIR=./data/chroma

# ===== Agent 任务规划 (plan-and-execute) =====
# research 意图先经 planner 分解为子查询再检索；false = 关闭，行为回退到旧版
# HD_PLANNER_ENABLED=true
# 每个计划最多包含的子查询数（1-4）
# HD_PLANNER_MAX_STEPS=4

# ===== 长期记忆（自动事实抽取 + 跨会话召回）=====
# 每轮对话结束后是否自动抽取用户事实写入 memory_facts 表
# HD_MEMORY_EXTRACTION_ENABLED=true
# 每轮注入 system prompt 的最大召回事实条数
# HD_MEMORY_MAX_FACTS=8

# ===== Feishu (Lark) knowledge base sync =====
# Get App ID + App Secret from https://open.feishu.cn (your app -> Credentials)
# Required scopes: wiki:wiki:readonly, docx:document:readonly, drive:document:readonly
FEISHU_ENABLED=false
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
FEISHU_API_BASE=https://open.feishu.cn
# Comma-separated space IDs (leave empty to sync every space the app can see)
FEISHU_SPACE_IDS=
# Minutes between automatic syncs (set 0 to disable background sync, use manual trigger only)
FEISHU_SYNC_INTERVAL_MIN=15
FEISHU_PAGE_SIZE=50
